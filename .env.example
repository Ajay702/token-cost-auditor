# Path to your JSONL usage log (one API call per line). Not needed for --demo.
AUDIT_LOGS=
# Price table (USD per 1M tokens). Edit prices.json to match current pricing.
AUDIT_PRICES=prices.json
# Where the markdown report is written.
AUDIT_OUT=output/cost_report.md
# Optional: only needed for --llm (Claude-written briefing).
ANTHROPIC_API_KEY=
AUDITOR_MODEL=claude-opus-5-5
